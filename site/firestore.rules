rules_version = '2';

// Paste this into Firebase Console → Firestore Database → Rules → Publish.
//
// Chats are organized as: organizeEventsChats/{groupId}/messages/{messageId}
// Anyone can read (no login required to browse), but posting requires a
// signed-in account (Firebase Authentication — email/password or Google).
// Each message must be tagged with the poster's own uid, so no one can
// post as someone else. No one can edit or delete a message once posted.

service cloud.firestore {
  match /databases/{database}/documents {
    match /organizeEventsChats/{groupId}/messages/{messageId} {
      allow read: if true;

      allow create: if request.auth != null
                    && groupId in ['mild', 'moderate', 'neurodivergent', 'other']
                    && request.resource.data.keys().hasOnly(['name', 'message', 'uid', 'createdAt'])
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 60
                    && request.resource.data.message is string
                    && request.resource.data.message.size() > 0
                    && request.resource.data.message.size() <= 1000
                    && request.resource.data.createdAt == request.time;

      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
